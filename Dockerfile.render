# Lightweight Render MCP: the host AI provides reasoning. No local model.
FROM python:3.13-slim
WORKDIR /opt/diamond
COPY pyproject.toml README_PYPI.md ./
RUN python -c "import tomllib,subprocess,sys; p=tomllib.load(open('pyproject.toml','rb')); subprocess.check_call([sys.executable,'-m','pip','install','--no-cache-dir',*p['project']['dependencies'],*p['project']['optional-dependencies']['postgres'],'setuptools>=75','wheel'])"
COPY src ./src
RUN python -m pip install --no-deps --no-build-isolation . && useradd --create-home --uid 10001 diamond
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY demo ./demo
# Build an index of the approved public sample using only trusted static parsers.
# Runtime restoration needs no GitHub access, upload or reanalysis after spin-down.
RUN python -I -m diamond_mcp.demo_seed build --source /opt/diamond/demo --output /opt/diamond/demo/state
ENV ORIGINSPAN_DEMO_SEED=/opt/diamond/demo/state
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DIAMOND_NEURAL_ENABLED=false
EXPOSE 10000
# Initialize the mounted state directory, then drop uid/gid before serving.
ENTRYPOINT ["python", "-I", "-m", "originspan.hosted"]
